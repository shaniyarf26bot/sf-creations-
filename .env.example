# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# STUDIO_ADMIN_PASSCODE: Passcode used to unlock the SF Creations Studio Manager dashboard.
# Set a strong private passcode before deploying to production.
STUDIO_ADMIN_PASSCODE="SF-STUDIO-2026"

# SMTP Email Configuration (Optional - enables automatic email alerts to sfcreations26@gmail.com)
# For Gmail, use smtp.gmail.com, port 465, your Gmail address, and a Google App Password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="sfcreations26@gmail.com"
SMTP_PASS=""
SMTP_FROM="SF Creations Website <sfcreations26@gmail.com>"
INQUIRY_RECIPIENT_EMAIL="sfcreations26@gmail.com"
